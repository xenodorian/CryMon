    "notes": {
      "capture": "captureAgl * agl + missingHpPercent + bonus + (vulnerable ? captureVulnerable : 0), clamp 0..100",
      "xpGain": "xpBase + foeLevel * xpPerLevel",
      "levelUp": "while xp >= level * levelXpMul and level < levelCap: xp -= level*levelXpMul; level++; maxHp+=levelHp; str/agl/spc += levelStat",
      "mintGrow": "1 + (level - mintBaseLevel) * mintGrowPerLevel",
      "shiny": "1/shinyDenom",
      "benchXp": "lead full XP; other living party members floor(xp * benchXpShare)",
      "nature": "on mint: +str/+agl/+spc from logic.json natures[i]; hardy is 0; stored in party slot byte 12"
